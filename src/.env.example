# Copy this file to .env and fill in your actual values
# NEVER commit the .env file — it is in .gitignore

# ─── IBM watsonx.ai ───────────────────────────────────────────────────────────
# Required by src/ai/watsonx_service.py
# API key from IBM Cloud → Manage → Access (IAM) → API keys
WATSONX_APIKEY=your_ibm_cloud_api_key_here

# watsonx.ai project ID (found in your watsonx.ai project settings)
WATSONX_PROJECT_ID=your_watsonx_project_id_here

# Regional endpoint — change to match your IBM Cloud region
# Regions: us-south | eu-de | eu-gb | jp-tok | au-syd
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Foundation model to use for generation
# Examples: ibm/granite-13b-instruct-v2  |  meta-llama/llama-3-70b-instruct
WATSONX_MODEL_ID=ibm/granite-13b-instruct-v2

# ─── Application ──────────────────────────────────────────────────────────────
APP_PORT=8000
# development | staging | production
APP_ENV=development
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/clinical_trial_db

# ─── Notifications (optional) ─────────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# ─── Add project-specific variables below ────────────────────────────────────
